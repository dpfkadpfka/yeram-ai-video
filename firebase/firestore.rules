rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isOwnerAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'dpfkadpfka@gmail.com' ||
        (exists(/databases/$(database)/documents/config/site) &&
         request.auth.token.email.lower() in get(/databases/$(database)/documents/config/site).data.admins));
    }
    // 반응 수: 한 번에 하나씩 ±1만
    function stepOk(k) {
      let before = resource == null ? 0 : resource.data.get(k, 0);
      let after = request.resource.data.get(k, 0);
      return after is int && after >= 0 && (after == before || after == before + 1 || after == before - 1);
    }
    function rxOk() {
      let keys = ['heart', 'like', 'lol', 'wow', 'clap', 'fire', 'c'];
      return request.resource.data.keys().hasOnly(keys)
        && stepOk('heart') && stepOk('like') && stepOk('lol') && stepOk('wow')
        && stepOk('clap') && stepOk('fire') && stepOk('c');
    }

    // 선생님 개인 기록: 본인만 읽고 쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 사이트 설정: 누구나 읽기, 관리자만 쓰기
    match /config/site {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'dpfkadpfka@gmail.com' ||
        (exists(/databases/$(database)/documents/config/site) &&
         request.auth.token.email.lower() in get(/databases/$(database)/documents/config/site).data.admins &&
         request.resource.data.admins == resource.data.admins)
      );
    }
    // 홈 캐릭터 영상(config/hv_…): 누구나 보기, 관리자만 쓰기
    match /config/{doc} {
      allow read: if true;
      allow write: if (doc.matches('hv_.*') || doc == 'event') && isOwnerAdmin();
    }
    // 연수 이벤트 당첨 기록: 미션별 하루 1명(먼저 만든 사람), 고치기 불가, 관리자만 지우기
    match /events/{id} {
      allow read: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid &&
        exists(/databases/$(database)/documents/config/event) &&
        get(/databases/$(database)/documents/config/event).data.on == true &&
        request.resource.data.day == get(/databases/$(database)/documents/config/event).data.day &&
        id == request.resource.data.day + '_' + request.resource.data.m;
      allow delete: if isOwnerAdmin();
    }
    // 선물 챙기기용 당첨 기록(이메일 포함): 본인 당첨만 생성, 예람쌤만 읽기·체크·삭제
    match /evwin/{id} {
      allow read, update, delete: if signed() && request.auth.token.email == 'dpfkadpfka@gmail.com';
      allow create: if signed() && request.resource.data.uid == request.auth.uid &&
        exists(/databases/$(database)/documents/events/$(id)) &&
        get(/databases/$(database)/documents/events/$(id)).data.uid == request.auth.uid;
    }
    // 이벤트 N번째 미션용 기록
    match /evlog/{id} {
      allow read: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid &&
        exists(/databases/$(database)/documents/config/event) &&
        get(/databases/$(database)/documents/config/event).data.on == true &&
        request.resource.data.day == get(/databases/$(database)/documents/config/event).data.day;
      allow delete: if isOwnerAdmin();
    }
    // 캐릭터 갤러리
    match /gallery/{id} {
      allow read: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow update: if signed() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports']) ||
        ((resource.data.uid == request.auth.uid || isOwnerAdmin()) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'name', 'kind'])));
      allow delete: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
    }
    match /galleryFull/{id} {
      allow read: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow update: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'name']);
      allow delete: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
    }
    // 작품 공유 (유튜브 링크 또는 Cloudinary 영상)
    match /works/{id} {
      allow read: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && (request.resource.data.url == "" || request.resource.data.url.matches('https://res[.]cloudinary[.]com/.*') || request.resource.data.url.matches('https://bold-morning-576f[.]dpfkadpfka[.]workers[.]dev/v/.*'));
      allow update: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'intro', 'name', 'who']);
      allow delete: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
    }
    // 커뮤니티 글·댓글
    match /community/{id} {
      allow read: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow update: if signed() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cmtN']) ||
        resource.data.uid == request.auth.uid || isOwnerAdmin());
      allow delete: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
      match /comments/{cid} {
        allow read: if true;
        allow create: if signed() && request.resource.data.uid == request.auth.uid;
        allow delete: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
      }
    }
    // 비공개 질문: 쓴 사람과 관리자만 보기·답변
    match /cpriv/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow update: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
      allow delete: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
      match /comments/{cid} {
        allow read: if signed() && (get(/databases/$(database)/documents/cpriv/$(id)).data.uid == request.auth.uid || isOwnerAdmin());
        allow create: if signed() && request.resource.data.uid == request.auth.uid && (get(/databases/$(database)/documents/cpriv/$(id)).data.uid == request.auth.uid || isOwnerAdmin());
        allow delete: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
      }
    }
    // 이미지 바로 그리기 기록: 본인은 자기 기록만, 소유자만 전부 보기. 고치기·지우기 불가
    match /imglog/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || request.auth.token.email == 'dpfkadpfka@gmail.com');
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
    }
    // 반응 댓글 한꺼번에 읽기(카드 미리보기)
    match /{path=**}/c/{cid} {
      allow read: if true;
    }
    // 갤러리 캐릭터·영상 반응(이모지)과 댓글
    match /rx/{key} {
      allow read: if true;
      allow create, update: if rxOk();
      match /c/{cid} {
        allow read: if true;
        allow create: if signed() && request.resource.data.uid == request.auth.uid &&
          request.resource.data.body is string && request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 300;
        allow delete: if signed() && (resource.data.uid == request.auth.uid || isOwnerAdmin());
      }
    }
  }
}
